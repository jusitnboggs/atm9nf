# 1. Ignore EVERYTHING by default
*

# 2. Allow essential repository & client files
!.gitignore
!.gitattributes
!README.md
!sync_pack.bat
!mmc-pack.json
!servers.dat
!.github/
!.github/**

# 3. Allow pack configs and scripts (docs is excluded)
!config/
!config/**
!defaultconfigs/
!defaultconfigs/**
!kubejs/
!kubejs/**
!scripts/
!scripts/**
!packmenu/
!packmenu/**

# 4. Allow specific custom mod jars
!mods/
!mods/Re-Avaritia_Ad Astra Oxygen Patch.jar

# 5. Never commit dev-tool secrets, caches, or run artifacts (these re-ignore
#    entries must stay AFTER the "!scripts/**" allow above -- last match wins).
#    The .example template is intentionally NOT matched here, so it stays tracked.
scripts/pack_sync.conf
scripts/dev/.curseforge_api_key
scripts/dev/.mod_check_cache.json
scripts/dev/.last_run.log
scripts/**/__pycache__/